\set ON_ERROR_STOP on
\getenv av_demo_aurora_password AV_DEMO_AURORA_PASSWORD
\getenv av_demo_cashier_email AV_DEMO_CASHIER_AURORA_EMAIL
\getenv av_demo_cashier_password AV_DEMO_CASHIER_AURORA_PASSWORD

\if :{?av_demo_aurora_password}
\else
  \echo 'Falta AV_DEMO_AURORA_PASSWORD en el entorno local.'
  DO $seed_abort$ BEGIN RAISE EXCEPTION 'CASHIER_SEED_ABORTED'; END $seed_abort$;
\endif
\if :{?av_demo_cashier_email}
\else
  \echo 'Falta AV_DEMO_CASHIER_AURORA_EMAIL en el entorno local.'
  DO $seed_abort$ BEGIN RAISE EXCEPTION 'CASHIER_SEED_ABORTED'; END $seed_abort$;
\endif
\if :{?av_demo_cashier_password}
\else
  \echo 'Falta AV_DEMO_CASHIER_AURORA_PASSWORD en el entorno local.'
  DO $seed_abort$ BEGIN RAISE EXCEPTION 'CASHIER_SEED_ABORTED'; END $seed_abort$;
\endif

select case when
    lower(:'av_demo_cashier_email') ~ '^[^@[:space:]]+@[a-z0-9.-]+\.invalid$'
    and length(:'av_demo_cashier_password') between 12 and 72
    and :'av_demo_cashier_password' ~ '[A-Z]'
    and :'av_demo_cashier_password' ~ '[a-z]'
    and :'av_demo_cashier_password' ~ '[0-9]'
  then 'true' else 'false' end as av_cashier_credentials_valid \gset
\if :av_cashier_credentials_valid
\else
  \echo 'Las credenciales sintéticas CAJERO no cumplen la política local.'
  DO $seed_abort$ BEGIN RAISE EXCEPTION 'CASHIER_SEED_ABORTED'; END $seed_abort$;
\endif

select encode(gen_random_bytes(32), 'hex') as av_admin_session_token,
       encode(gen_random_bytes(32), 'hex') as av_admin_csrf_token \gset

select case when exists (
    select 1
      from identity_auth.authenticate_and_create_session(
          'STAFF',
          'veterinaria-aurora',
          'administracion@demo.invalid',
          :'av_demo_aurora_password',
          encode(digest(:'av_admin_session_token', 'sha256'), 'hex'),
          encode(digest(:'av_admin_csrf_token', 'sha256'), 'hex'),
          statement_timestamp() + interval '8 hours'
       )
) then 'true' else 'false' end as av_admin_authenticated \gset
\if :av_admin_authenticated
\else
  \echo 'No fue posible autenticar al administrador sintético de Aurora.'
  DO $seed_abort$ BEGIN RAISE EXCEPTION 'CASHIER_SEED_ABORTED'; END $seed_abort$;
\endif

select exists (
    select 1
      from identity_auth.list_staff_for_session(encode(digest(:'av_admin_session_token', 'sha256'), 'hex')) staff
     where staff.normalized_email = lower(:'av_demo_cashier_email')
) as av_cashier_exists \gset

select coalesce((
    select staff.account_status = 'ACTIVA' and staff.roles = jsonb_build_array('CAJERO')
      from identity_auth.list_staff_for_session(encode(digest(:'av_admin_session_token', 'sha256'), 'hex')) staff
     where staff.normalized_email = lower(:'av_demo_cashier_email')
), false) as av_cashier_active_exact \gset

\if :av_cashier_active_exact
  select identity_auth.revoke_session_by_token(encode(digest(:'av_admin_session_token', 'sha256'), 'hex'))
    as av_admin_session_revoked \gset
  \echo 'La cuenta sintética CAJERO de Aurora ya está activa con el rol exclusivo autorizado; se conserva sin cambios.'
\else
  \if :av_cashier_exists
    \echo 'Existe una cuenta con el correo CAJERO sintético, pero no cumple el estado y rol exclusivo requeridos.'
    DO $seed_abort$ BEGIN RAISE EXCEPTION 'CASHIER_SEED_CONFLICTING_ACCOUNT'; END $seed_abort$;
  \else
    select encode(gen_random_bytes(32), 'hex') as av_cashier_invitation_token \gset
    select case when exists (
        select 1
          from identity_auth.invite_staff(
              encode(digest(:'av_admin_session_token', 'sha256'), 'hex'),
              lower(:'av_demo_cashier_email'),
              jsonb_build_array('CAJERO'),
              encode(digest(:'av_cashier_invitation_token', 'sha256'), 'hex'),
              statement_timestamp() + interval '24 hours'
          )
    ) then 'true' else 'false' end as av_cashier_invited \gset
    \if :av_cashier_invited
    \else
      \echo 'No fue posible registrar la invitación sintética CAJERO.'
      DO $seed_abort$ BEGIN RAISE EXCEPTION 'CASHIER_SEED_ABORTED'; END $seed_abort$;
    \endif

    select identity_auth.accept_staff_invitation(
        encode(digest(:'av_cashier_invitation_token', 'sha256'), 'hex'),
        crypt(:'av_demo_cashier_password', gen_salt('bf', 10))
    ) as av_cashier_principal_id \gset

    select coalesce((
        select staff.account_status = 'ACTIVA' and staff.roles = jsonb_build_array('CAJERO')
          from identity_auth.list_staff_for_session(encode(digest(:'av_admin_session_token', 'sha256'), 'hex')) staff
         where staff.normalized_email = lower(:'av_demo_cashier_email')
    ), false) as av_cashier_activated \gset
    \if :av_cashier_activated
    \else
      \echo 'La invitación no activó una cuenta CAJERO con el rol exclusivo requerido.'
      DO $seed_abort$ BEGIN RAISE EXCEPTION 'CASHIER_SEED_ABORTED'; END $seed_abort$;
    \endif

    select identity_auth.revoke_session_by_token(encode(digest(:'av_admin_session_token', 'sha256'), 'hex'))
      as av_admin_session_revoked \gset
    \echo 'Cuenta sintética CAJERO de Aurora preparada mediante invitación y aceptación autorizadas.'
  \endif
\endif
